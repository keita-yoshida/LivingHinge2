{
  "name": "livinghinge-generator",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "description": "レーザー加工用カーフベンディング/リビングヒンジパターン ジェネレーター",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run build",
    "test": "npm run test:golden && npm run test:smoke",
    "test:golden": "node tools/golden.mjs check",
    "test:smoke": "node tools/smoke.mjs",
    "golden:capture": "node tools/golden.mjs capture"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
